---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { shop } from '../data/site';
import { asset } from '../lib/url';

interface Props {
  title: string;
  description: string;
  preload?: string;
}

const { title, description, preload } = Astro.props;
const image = new URL(asset('images/storefront-facade.jpg'), Astro.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: shop.legalName,
  alternateName: shop.wordmark,
  foundingDate: shop.opened,
  telephone: shop.phoneTel,
  email: shop.email,
  image,
  address: {
    '@type': 'PostalAddress',
    streetAddress: shop.street,
    addressLocality: shop.locality,
    addressRegion: shop.region,
    postalCode: shop.postal,
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '09:00',
      closes: '17:00',
    },
  ],
  sameAs: [shop.instagram, shop.facebook, shop.tiktok, shop.currentSite, shop.honey],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Review build: remove this robots tag when the site replaces the live shop domain. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#236e77" />
    <link rel="icon" href={asset('favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" href={asset('favicon.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {preload && <link rel="preload" as="image" href={asset(preload)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Lightbox />
  </body>
</html>

---
import Base from '../layouts/Base.astro';

const title = 'Expansion · Woodstock Coffee & Bakeshop';
const description =
  'Expansion is on the horizon! A new coffee bar, updated lobby space, expanded menu and a family centered space. So much is coming to Jackson!';
---

<Base title={title} description={description}>
  <!-- Section 1: The Woodstock you love is staying -->
  <header class="page-hero pop-hero center-hero expansion-hero" data-section="1">
    <div class="wrap">
      <h1>The Woodstock you love is staying.</h1>
      <p class="lede">
        Expansion is on the horizon! A new coffee bar, updated lobby space, expanded menu and a family centered space. So much is coming to Jackson! Follow along here for exclusive updates on our developing business as we tear down walls, design the space, and build something amazing!!
      </p>
    </div>
  </header>

  <!-- Section 2: Coming soon -->
  <section class="section expansion-soon" data-section="2">
    <div class="soon-stage">
      <div class="soon-blur" aria-hidden="true">
        <span class="soon-blob soon-blob-a"></span>
        <span class="soon-blob soon-blob-b"></span>
        <span class="soon-blob soon-blob-c"></span>
        <span class="soon-blob soon-blob-d"></span>
      </div>
      <h2>Coming soon</h2>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { breads, sandwiches, shop } from '../data/site';
import { asset } from '../lib/url';

const title = 'Lunch · Woodstock Coffee & Bakeshop';
const description =
  'The classic Woodstock lunch: a sandwich, cupcake, chips, and a handwritten note. $10, plus a canned drink for a dollar. Order on the shop form. Jackson, Tennessee.';
---

<Base title={title} description={description}>
  <!-- Section 1: Box lunches -->
  <header class="page-hero pop-hero center-hero" data-section="1">
    <div class="wrap">
      <h1>Box lunches</h1>
      <p class="lunch-sub">to go</p>
      <p class="lede">
        The classic Woodstock lunch: a sandwich, cupcake, chips, and a handwritten note in the box. Visit the link below to order today!
      </p>
      <p class="hero-actions">
        <a class="btn" href={shop.lunchForm}>Order box lunches</a>
        <a class="btn btn-ghost" href={`tel:${shop.phoneTel}`}>Call {shop.phoneDisplay}</a>
      </p>
    </div>
  </header>

  <!-- Section 2: The box -->
  <section class="section lunch-box" data-section="2">
    <div class="wrap">
      <p class="lunch-offer">a sandwich, a cupcake, and chips all for just $10 +add a canned drink for a dollar!</p>
      <img
        class="lunch-photo"
        src={asset('images/lunch-3812.jpg')}
        width="1200"
        height="1600"
        alt="An open box lunch with a croissant sandwich, a pink-frosted cupcake, Miss Vickie’s chips, and a handwritten note that reads Do all things in love."
        loading="lazy"
        decoding="async"
      />
      <h2>Options</h2>
      <table class="price-table">
        <caption class="visually-hidden">Sandwich prices</caption>
        <thead>
          <tr>
            <th scope="col">Option</th>
            <th scope="col">Price</th>
          </tr>
        </thead>
        <tbody>
          {sandwiches.map((item) => (
            <tr>
              <th scope="row">{item.name}</th>
              <td>{item.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <h2>Breads</h2>
      <ul class="bread-chips">
        {breads.map((bread) => <li>{bread}</li>)}
      </ul>
      <div class="lunch-dale">
        <h2>Dale Childress started that.</h2>
        <p>
          Matt Childress founded Woodstock with his father. Dale suggested the name, and he is the one who began writing inside the to-go boxes — a short, personal line, so lunch did not leave as just lunch. The habit is still how a Woodstock box goes out the door. The words change. The note stays.
        </p>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import RevolveBadge from '../components/RevolveBadge.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { shop } from '../data/site';
import { asset, href } from '../lib/url';

const makeStrip = [
  { code: '9425', width: 1200, height: 1600, alt: 'A heart-shaped burgundy cake with black ribbon bows, ruffled borders, and white script reading Happy 20th.' },
  { code: '9014', width: 1200, height: 1600, alt: 'Rows of cupcakes with pink, chocolate, and white frosting and sprinkles.' },
  { code: '8947', width: 1200, height: 1600, alt: 'A heart-shaped cake with a pale pink top, white ruffles, and piped roses in pink, blue, and yellow.' },
  { code: '8815', width: 1200, height: 1600, alt: 'A white heart-shaped cake with scalloped borders, draped swags, and small pearl dots.' },
  { code: '8757', width: 1068, height: 1600, alt: 'A blue cake piped with green and pink borders and topped with orange carrots.' },
  { code: '8531', width: 1200, height: 1600, alt: 'A lavender cake topped with white buttercream roses and sprigs of baby’s breath.' },
  { code: '7951', width: 1200, height: 1600, alt: 'Rows of boxed lunches, each with a wrapped sandwich, a bag of chips, and a cupcake.' },
  { code: '7338', width: 1200, height: 1600, alt: 'A box of cupcakes frosted as farm animals, including sheep, pigs, chicks, and cows.' },
  { code: '7272', width: 1200, height: 1600, alt: 'A round ivory cake with blue shell borders and a yellow bird outlined in black on top.' },
  { code: '6201', width: 1200, height: 1600, alt: 'A three-tier white cake with draped swags and small pink flowers.' },
  { code: '6159', width: 1200, height: 1600, alt: 'A box of cupcakes piped as blue hydrangeas and pale pink roses with green leaves.' },
  { code: '5298', width: 1200, height: 1600, alt: 'A pale green cake lettered Sixteen, topped with red mushrooms and green vines.' },
  { code: '5402', width: 1200, height: 1600, alt: 'A teal heart-shaped cake decorated with pink and red piped flowers and green leaves.' },
  { code: '3597', width: 1200, height: 1600, alt: 'A two-tier lavender cake with cream ruffles, small burgundy roses, and green vines.' },
  { code: '3714', width: 1200, height: 1600, alt: 'A green cake with shell borders and white script reading “a tini bit older.”' },
  { code: '3465', width: 1200, height: 1600, alt: 'A sheet cake with pale green frosting, a dark green ruffled border, and small green piped shapes.' },
  { code: '3108', width: 1200, height: 1600, alt: 'A box of cupcakes piped as colorful flowers in pink, yellow, orange, and purple.' },
  { code: '3157', width: 1200, height: 1600, alt: 'A two-tier cake with a white top, a rose-gold bottom, and a cluster of pink and white flowers.' },
  { code: '2317', width: 1200, height: 1600, alt: 'Two yellow cakes, one with a small bee and flowers, the other with a pink lattice and bees.' },
  { code: '2272', width: 1200, height: 1600, alt: 'Mini cupcakes with white frosting, purple daisies, and sprigs of baby’s breath on a white tray.' },
  { code: '2083', width: 1200, height: 1600, alt: 'A box of cupcakes piped as pink roses and red and mauve flowers with green centers.' },
  { code: '0965', width: 1200, height: 1600, alt: 'A large chocolate chip cookie cake bordered with pink and white frosting and lettered Happy Birthday.' },
].map((photo) => ({
  ...photo,
  src: `images/strip/strip-${photo.code}.jpg`,
  thumb: `images/strip/thumbs/strip-${photo.code}.jpg`,
}));

const title = 'Woodstock Coffee & Bakeshop · Jackson, Tennessee';
const description =
  'Woodstock Coffee & Bakeshop, est. 2012, at 80 Innsdale Cv in Jackson, Tennessee. Coffee, custom cakes, and box lunches. Open Monday–Saturday, 9am–5pm.';
---

<Base title={title} description={description} preload="images/untitled-design.png">
  <header class="logo-hero">
    <h1 class="visually-hidden">Woodstock Coffee &amp; Bakeshop</h1>
    <div class="logo-hero-frame">
      <img
        class="logo-hero-mark"
        src={asset('images/untitled-design.png')}
        width="1999"
        height="1545"
        alt="Woodstock Coffee & Bakeshop. WOODSTOCK in brown with a sunflower as the second O, a green leafy vine above, and Coffee & Bakeshop below, on a cream background."
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </header>

  <section class="home-info">
    <h2 class="visually-hidden">Hours and contact</h2>
    <RevolveBadge id="revolve-info" />
    <p class="hero-lede wrap">
      Established 2012, off of Vann Drive in Jackson, Tennessee.
    </p>
    <dl class="hero-facts wrap">
      <div>
        <dt>Hours now</dt>
        <dd>Mon–Sat 9am–5pm<br />Sunday closed</dd>
        <p class="hours-aside">
          These are today’s hours. Longer days are coming, and they are listed only on the{' '}
          <a href={href('/expansion')}>Expansion</a>{' '}page.
        </p>
      </div>
      <div>
        <dt>Visit</dt>
        <dd>
          <a href={shop.map}>{shop.street}<br />Jackson, TN 38305</a>
        </dd>
      </div>
      <div>
        <dt>Call</dt>
        <dd><a href={`tel:${shop.phoneTel}`}>{shop.phoneDisplay}</a></dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${shop.email}`}>{shop.email}</a></dd>
      </div>
    </dl>
    <SocialLinks />
  </section>

  <section class="home-orders">
    <h2 class="visually-hidden">Order</h2>
    <div class="home-orders-grid">
      <a class="order-offer" href={shop.cakeForm}>
        <span class="btn">Order a cake</span>
        <img
          src={asset('images/cake-order.jpg')}
          width="1200"
          height="1600"
          alt="A white buttercream cake with pale-blue piped swags, ruffles, and blueberries on top."
          decoding="async"
        />
      </a>
      <a class="order-offer" href={shop.lunchForm}>
        <span class="btn">Order a box lunch</span>
        <img
          src={asset('images/box-lunch-order.jpg')}
          width="1200"
          height="1600"
          alt="Packed box lunches, each with a wrapped sandwich, a bag of chips, and a frosted cupcake."
          decoding="async"
        />
      </a>
    </div>
  </section>

  <section class="section home-make">
    <div class="wrap">
      <p class="kicker">What we make</p>
      <h2>Coffee, cakes, and catering. And a box lunch with a special note in it!</h2>
      <ol class="toc">
        <li>
          <a href={href('/cafe')}>
            <span class="toc-num">01</span>
            <span>
              <strong>Coffee</strong>
              <em>House-made syrups, and the coffee menu we pour now.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={href('/cakes')}>
            <span class="toc-num">02</span>
            <span>
              <strong>Cakes</strong>
              <em>Three sizes, four priced designs, and a kitchen album.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={href('/catering')}>
            <span class="toc-num">03</span>
            <span>
              <strong>Catering</strong>
              <em>Bulk box lunches, cupcakes, and delivery. Call us.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={href('/lunch')}>
            <span class="toc-num">04</span>
            <span>
              <strong>Lunch</strong>
              <em>The classic box, Miss Vickie’s, and Dale’s handwritten notes.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
      </ol>
    </div>
    <div class="make-marquee" tabindex="0" aria-label="Photos from the shop">
      <div class="make-marquee-track">
        {
          [0, 1].map((copy) => (
            <ul class="make-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {makeStrip.map((photo) => (
                <li>
                  <a
                    href={asset(photo.src)}
                    data-lightbox
                    data-group="make"
                    data-src={asset(photo.src)}
                    data-alt={photo.alt}
                    data-caption={photo.alt}
                  >
                    <img
                      src={asset(photo.thumb)}
                      width="600"
                      height={Math.round(600 * photo.height / photo.width)}
                      alt={copy === 1 ? '' : photo.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>
  <script>
    const scroller = document.querySelector<HTMLElement>('.make-marquee');
    if (scroller && !scroller.dataset.ready) {
      scroller.dataset.ready = 'true';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fineHover = window.matchMedia('(hover: hover)').matches;
      let hover = false;
      let pointers = 0;
      let holdUntil = 0;
      let moved = false;
      let startLeft = 0;
      let dragX = 0;
      let dragLeft = 0;
      let last = 0;
      const speed = 40;

      const halfWidth = () => scroller.scrollWidth / 2;
      const looping = () => {
        const copy = scroller.querySelector('.make-marquee-group[aria-hidden="true"]');
        return !reduce && !!copy && getComputedStyle(copy).display !== 'none';
      };
      const wrap = () => {
        if (!looping()) return;
        const half = halfWidth();
        if (half > 8 && scroller.scrollLeft >= half) scroller.scrollLeft -= half;
      };
      const holding = () => hover || pointers > 0 || performance.now() < holdUntil || !!document.querySelector('dialog[open]');

      const frame = (now: number) => {
        if (!last) last = now;
        const dt = Math.min(48, now - last);
        last = now;
        if (!reduce && !holding()) {
          scroller.classList.remove('is-user');
          scroller.scrollLeft += (speed * dt) / 1000;
          wrap();
        }
        requestAnimationFrame(frame);
      };

      scroller.addEventListener('mouseenter', () => {
        if (fineHover) hover = true;
      });
      scroller.addEventListener('mouseleave', () => {
        hover = false;
      });
      scroller.addEventListener('pointerdown', (event) => {
        pointers += 1;
        moved = false;
        startLeft = scroller.scrollLeft;
        dragX = event.clientX;
        dragLeft = scroller.scrollLeft;
        scroller.classList.add('is-user');
      });
      scroller.addEventListener('pointermove', (event) => {
        if (pointers === 0) return;
        if (Math.abs(scroller.scrollLeft - startLeft) > 6) moved = true;
        if (event.pointerType === 'touch') return;
        const dx = event.clientX - dragX;
        if (Math.abs(dx) > 6) moved = true;
        scroller.scrollLeft = dragLeft - dx;
        wrap();
      });
      const release = () => {
        pointers = Math.max(0, pointers - 1);
        holdUntil = performance.now() + 3500;
      };
      scroller.addEventListener('pointerup', release);
      scroller.addEventListener('pointercancel', release);
      scroller.addEventListener('wheel', () => {
        scroller.classList.add('is-user');
        holdUntil = performance.now() + 3500;
        requestAnimationFrame(wrap);
      }, { passive: true });
      scroller.addEventListener('scroll', () => wrap(), { passive: true });
      scroller.addEventListener('click', (event) => {
        if (!moved) return;
        event.preventDefault();
        event.stopPropagation();
        moved = false;
      }, true);

      if (!reduce) requestAnimationFrame(frame);
    }
  </script>

  <section class="home-hero">
    <div class="home-stage">
      <figure class="home-doors">
        <img
          src={asset('images/storefront-doors.jpg')}
          width="1600"
          height="2133"
          alt="Glass doors of the shop, with a neon Open sign, vintage chairs, and warm light inside."
          decoding="async"
        />
        <figcaption>The front doors, Suite A.</figcaption>
      </figure>
      <div class="home-brand">
        <figure class="home-lockup">
          <img
            src={asset('images/brand-floral-lockup.jpg')}
            width="1400"
            height="1082"
            alt="A floral shop graphic: the words Woodstock Coffee & Bakeshop curve around a sunflower marked WS, with flowers and butterflies on a brown ground."
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="section block-teal">
    <div class="wrap split">
      <div class="prose">
        <p class="kicker">Since 2012</p>
        <h2>A neighborhood bakery, still on the same cove.</h2>
        <p>
          First established in 2012, in Jackson, Tennessee, Woodstock met the community with something of its own.
          Matt Childress and his father, Dale Childress, founded the shop. Dale suggested the name.
        </p>
        <figure class="pull">
          <p>
            Woodstock proved that a unique and nostalgic aesthetic, as well as a Christ-centered mission, would bring smiles to the faces of all who stepped through the doors.
          </p>
          <cite>From the shop’s own account of its founding</cite>
        </figure>
        <p>
          Through the years, Woodstock made a name by generosity and genuine care. In late 2024 the shop came under new ownership by David, April, and Elena Parkerson. With love for the mission the previous owners instilled, the Parkersons continued the heart of Woodstock while bringing back the vintage element customers find so inviting.
        </p>
        <p>
          From the street you can see lively color and warm light. Inside, the furniture is vintage and comfortable: a place for studying, reading, and chatting. The shop is right off Vann Drive.
        </p>
      </div>
      <Shot
        src="images/storefront-facade.jpg"
        width="1800"
        height="2399"
        group="home"
        alt="The Woodstock storefront at 80 Innsdale Cove: a white facade, a sunflower sign with the letters WS, and a neon Open sign in the window."
      />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap split">
      <Shot
        src="images/elena-parkerson.jpg"
        width="1500"
        height="2026"
        group="home"
        alt="Elena Parkerson standing in front of the teal gallery wall at Woodstock."
      />
      <div class="prose">
        <p class="kicker">Owner / operator</p>
        <h2>Meet the owner/operator, Elena Parkerson.</h2>
        <p>
          Elena runs Woodstock day to day. She and her family took over the shop in late 2024, keeping the Christ-centered heart that Matt and Dale Childress built in 2012 and bringing back the nostalgic, vintage feel that makes the rooms so easy to settle into: the vintage furniture, the warm lights, and the teal gallery wall. From the lattes to the custom cakes to the notes tucked inside every box lunch, she's the reason the shop still feels like Woodstock.
        </p>
      </div>
    </div>
  </section>

  <section class="section lobby-section" style="padding-top:0">
    <div class="wrap">
      <p class="kicker">The lobby</p>
      <h2>Step inside.</h2>
      <div class="lobby">
        <figure class="lobby-frame lobby-wall">
          <img
            src={asset('images/interior-gallery-wall.jpg')}
            width="1600"
            height="1902"
            alt="A teal wall covered with framed pictures, woven pendant lamps, a rust-colored sofa, and a basket of chip bags."
            loading="lazy"
          />
          <figcaption>The gallery wall. Vintage frames, warm lamps, and a basket of Miss Vickie’s.</figcaption>
        </figure>
        <figure class="lobby-frame lobby-juke">
          <img
            src={asset('images/interior-jukebox.jpg')}
            width="1600"
            height="2133"
            alt="The shop interior: a jukebox, a bakery case, pendant lights, and a Woodstock sunflower sign on the wall."
            loading="lazy"
          />
          <figcaption>The case, the jukebox, and the sign on the wall.</figcaption>
        </figure>
        <figure class="lobby-frame lobby-merch">
          <img
            src={asset('images/interior-merch-corner.jpg')}
            width="1500"
            height="2000"
            alt="A lobby corner with a clothing rack, record shelves, and a handwritten sign that reads Woodstock merch coming soon."
            loading="lazy"
          />
          <figcaption>The lobby corner. The sign says merch is coming soon.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="band section">
    <div class="wrap partner">
      <Shot
        src="images/mockups/honey-be-good-play-sketch.jpg"
        width="1080"
        height="681"
        group="partner"
        alt="Pencil sketch of a play café: a wooden play structure with slides on the left, and a long row of tables on the right. The drawing reads Honey Be Good Family Cafe and Jackson’s first play café."
        caption="Honey Be Good’s own sketch of the play space, shared here as neighbors."
      />
      <div>
        <p class="kicker">Same building · opening 2027</p>
        <h2>Honey Be Good is next door, and it is its own place.</h2>
        <p>
          Honey Be Good Family Cafe — play, sip, belong — is opening in 2027 at 80 Innsdale Cove, in the building with us. Parents will have a trusted room for safe, supervised play while coffee stays at Woodstock.
        </p>
        <p>
          We are partners. We are not the same shop, and their memberships are theirs. If you want Honey Be Good, go to them.
        </p>
        <p>
          <a class="btn btn-sun" href={shop.honey} target="_blank" rel="noopener noreferrer">Visit honeybeegood.cafe</a>
        </p>
      </div>
    </div>
  </section>

  <section class="chapter-tease" aria-labelledby="chapter-title">
    <img
      src={asset('images/mockups/coffee-bar-render-people.jpg')}
      width="1280"
      height="720"
      alt="Concept rendering of a future coffee bar with a teal counter, pastry case, and people gathered around it. A design study, not a photograph, and the people are not our staff."
      loading="lazy"
    />
    <div class="chapter-tease-copy">
      <p class="kicker">A chapter, not a banner</p>
      <h2 id="chapter-title">The Woodstock you love is staying.</h2>
      <p>
        New things are on the horizon: a coffee bar with room to spread out, more places to sit, and the play café beside us. The picture is a study for that room. It is not a photograph of a finished build, and the figures are not our team.
      </p>
      <p>
        <a class="btn btn-sun" href={href('/expansion')}>Read the expansion chapter</a>
      </p>
    </div>
  </section>

  <section class="section block-dust">
    <div class="wrap">
      <div class="prose">
        <p class="kicker">Come by</p>
        <h2>80 Innsdale Cove, Suite A.</h2>
        <p>
          {shop.neighborhood} Monday through Saturday we are open 9am to 5pm. Sunday the door is closed. If you need a cake or a stack of box lunches, the order forms are the same ones the shop uses today, or you can call {shop.phoneDisplay}.
        </p>
        <p class="cluster">
          <a class="btn" href={`tel:${shop.phoneTel}`}>Call the shop</a>
          <a class="btn btn-ghost" href={shop.map}>Map</a>
          <a class="btn btn-ghost" href={shop.instagram}>Instagram</a>
        </p>
      </div>
    </div>
  </section>
</Base>

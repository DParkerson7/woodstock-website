  { code: '6201', width: 1200, height: 1600, alt: 'A three-tier white cake with draped swags and small pink flowers.' },
  { code: '6159', width: 1200, height: 1600, alt: 'A box of cupcakes piped as blue hydrangeas and pale pink roses with green leaves.' },
  { code: '5298', width: 1200, height: 1600, alt: 'A pale green cake lettered Sixteen, topped with red mushrooms and green vines.' },
  { code: '5402', width: 1200, height: 1600, alt: 'A teal heart-shaped cake decorated with pink and red piped flowers and green leaves.' },
  { code: '3597', width: 1200, height: 1600, alt: 'A two-tier lavender cake with cream ruffles, small burgundy roses, and green vines.' },
  { code: '3714', width: 1200, height: 1600, alt: 'A green cake with shell borders and white script reading “a tini bit older.”' },
  { code: '3465', width: 1200, height: 1600, alt: 'A sheet cake with pale green frosting, a dark green ruffled border, and small green piped shapes.' },
  { code: '3108', width: 1200, height: 1600, alt: 'A box of cupcakes piped as colorful flowers in pink, yellow, orange, and purple.' },
  { code: '3157', width: 1200, height: 1600, alt: 'A two-tier cake with a white top, a rose-gold bottom, and a cluster of pink and white flowers.' },
  { code: '2317', width: 1200, height: 1600, alt: 'Two yellow cakes, one with a small bee and flowers, the other with a pink lattice and bees.' },
  { code: '2272', width: 1200, height: 1600, alt: 'Mini cupcakes with white frosting, purple daisies, and sprigs of baby’s breath on a white tray.' },
  { code: '2083', width: 1200, height: 1600, alt: 'A box of cupcakes piped as pink roses and red and mauve flowers with green centers.' },
  { code: '0965', width: 1200, height: 1600, alt: 'A large chocolate chip cookie cake bordered with pink and white frosting and lettered Happy Birthday.' },
].map((photo) => ({
  ...photo,
  src: `images/strip/strip-${photo.code}.jpg`,
  thumb: `images/strip/thumbs/strip-${photo.code}.jpg`,
}));

const title = 'Woodstock Coffee & Bakeshop · Jackson, Tennessee';
const description =
  'Woodstock Coffee & Bakeshop, est. 2012, at 80 Innsdale Cv in Jackson, Tennessee. Coffee, custom cakes, and box lunches. Open Monday–Saturday, 9am–5pm.';
---

<Base title={title} description={description} preload="images/untitled-design.png">
  <!-- Banner: header logo. Stays first. Not part of the numbered homepage sequence. -->
  <header class="logo-hero" data-section="banner">
    <h1 class="visually-hidden">Woodstock Coffee &amp; Bakeshop</h1>
    <div class="logo-hero-frame">
      <img
        class="logo-hero-mark"
        src={asset('images/untitled-design.png')}
        width="1999"
        height="1545"
        alt="Woodstock Coffee & Bakeshop. WOODSTOCK in brown with a sunflower as the second O, a green leafy vine above, and Coffee & Bakeshop below, on a cream background."
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </header>

  <!-- Hours and contact. Stays directly under the header. Not part of the numbered sequence. -->
  <section class="home-info" data-section="hours">
    <h2 class="visually-hidden">Hours and contact</h2>
    <RevolveBadge id="revolve-info" />
    <p class="hero-lede wrap">
      Established 2012, off of Vann Drive in Jackson, Tennessee.
    </p>
    <dl class="hero-facts wrap">
      <div>
        <dt>Hours now</dt>
        <dd>Mon–Sat 9am–5pm<br />Sunday closed</dd>
        <p class="hours-aside">
          These are today’s hours. Longer days are coming, and they are listed only on the{' '}
          <a href={href('/expansion')}>Expansion</a>{' '}page.
        </p>
      </div>
      <div>
        <dt>Visit</dt>
        <dd>
          <a href={shop.map}>{shop.street}<br />Jackson, TN 38305</a>
        </dd>
      </div>
      <div>
        <dt>Call</dt>
        <dd><a href={`tel:${shop.phoneTel}`}>{shop.phoneDisplay}</a></dd>
      </div>
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${shop.email}`}>{shop.email}</a></dd>
      </div>
    </dl>
    <SocialLinks />
  </section>

  <!-- Section 1: What we make -->
  <section class="section home-make" data-section="1">
    <div class="wrap home-make-stage">
      <div class="home-make-copy">
      <h2>What we make</h2>
      <ol class="toc">
        <li>
          <a href={href('/cafe')}>
            <span class="toc-num">01</span>
            <span>
              <strong>Coffee</strong>
              <em>House-made syrups, and the coffee menu we pour now.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={href('/cakes')}>
            <span class="toc-num">02</span>
            <span>
              <strong>Cakes</strong>
              <em>Three sizes, four priced designs, and a kitchen album.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={href('/catering')}>
            <span class="toc-num">03</span>
            <span>
              <strong>Catering</strong>
              <em>Bulk box lunches, cupcakes, and delivery. Call us.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href={href('/lunch')}>
            <span class="toc-num">04</span>
            <span>
              <strong>Lunch</strong>
              <em>The classic box, Miss Vickie’s, and Dale’s handwritten notes.</em>
            </span>
            <span class="toc-go" aria-hidden="true">→</span>
          </a>
        </li>
      </ol>
      </div>
      <figure class="make-loop">
        <video
          class="ambient"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={asset('images/what-we-make-loop-poster.jpg')}
          width="608"
          height="1080"
          aria-label="A gloved hand spreading pale pink frosting over a layer cake on a gold turntable."
        >
          <source src={asset('media/what-we-make-loop.mp4')} type="video/mp4" />
        </video>
      </figure>
    </div>
    <div class="make-marquee" tabindex="0" aria-label="Photos from the shop">
      <div class="make-marquee-track">
        {
          [0, 1].map((copy) => (
            <ul class="make-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {makeStrip.map((photo) => (
                <li>
                  <a
                    href={asset(photo.src)}
                    data-lightbox
                    data-group="make"
                    data-src={asset(photo.src)}
                    data-alt={photo.alt}
                  >
                    <img
                      src={asset(photo.thumb)}
                      width="600"
                      height={Math.round(600 * photo.height / photo.width)}
                      alt={copy === 1 ? '' : photo.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>
  <script>
    const scroller = document.querySelector<HTMLElement>('.make-marquee');
    if (scroller && !scroller.dataset.ready) {
      scroller.dataset.ready = 'true';
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const fineHover = window.matchMedia('(hover: hover)').matches;
      let hover = false;
      let pointers = 0;
      let holdUntil = 0;
      let moved = false;
      let startLeft = 0;
      let dragX = 0;
      let dragLeft = 0;
      let last = 0;
      const speed = 40;

      const halfWidth = () => scroller.scrollWidth / 2;
      const looping = () => {
        const copy = scroller.querySelector('.make-marquee-group[aria-hidden="true"]');
        return !reduce && !!copy && getComputedStyle(copy).display !== 'none';
      };
      const wrap = () => {
        if (!looping()) return;
        const half = halfWidth();
        if (half > 8 && scroller.scrollLeft >= half) scroller.scrollLeft -= half;
      };
      const holding = () => hover || pointers > 0 || performance.now() < holdUntil || !!document.querySelector('dialog[open]');

      const frame = (now: number) => {
        if (!last) last = now;
        const dt = Math.min(48, now - last);
        last = now;
        if (!reduce && !holding()) {
          scroller.classList.remove('is-user');
          scroller.scrollLeft += (speed * dt) / 1000;
          wrap();
        }
        requestAnimationFrame(frame);
      };

      scroller.addEventListener('mouseenter', () => {
        if (fineHover) hover = true;
      });
      scroller.addEventListener('mouseleave', () => {
        hover = false;
      });
      scroller.addEventListener('pointerdown', (event) => {
        pointers += 1;
        moved = false;
        startLeft = scroller.scrollLeft;
        dragX = event.clientX;
        dragLeft = scroller.scrollLeft;
        scroller.classList.add('is-user');
      });
      scroller.addEventListener('pointermove', (event) => {
        if (pointers === 0) return;
        if (Math.abs(scroller.scrollLeft - startLeft) > 6) moved = true;
        if (event.pointerType === 'touch') return;
        const dx = event.clientX - dragX;
        if (Math.abs(dx) > 6) moved = true;
        scroller.scrollLeft = dragLeft - dx;
        wrap();
      });
      const release = () => {
        pointers = Math.max(0, pointers - 1);
        holdUntil = performance.now() + 3500;
      };
      scroller.addEventListener('pointerup', release);
      scroller.addEventListener('pointercancel', release);
      scroller.addEventListener('wheel', () => {
        scroller.classList.add('is-user');
        holdUntil = performance.now() + 3500;
        requestAnimationFrame(wrap);
      }, { passive: true });
      scroller.addEventListener('scroll', () => wrap(), { passive: true });
      scroller.addEventListener('click', (event) => {
        if (!moved) return;
        event.preventDefault();
        event.stopPropagation();
        moved = false;
      }, true);

      if (!reduce) requestAnimationFrame(frame);
    }
  </script>

  <!-- Section 2: Step inside -->
  <section class="section lobby-section" data-section="2" style="padding-top:0">
    <div class="wrap">
      <h2 class="lobby-title">Step inside</h2>
      <p class="lobby-sub">the lobby</p>
      <div class="lobby-collage">
        <figure class="lobby-item mat-teal">
          <a
            href={asset('images/interior-gallery-wall.jpg')}
            data-lightbox
            data-group="lobby"
            data-src={asset('images/interior-gallery-wall.jpg')}
            data-alt="A teal wall covered with framed pictures, woven pendant lamps, a rust-colored sofa, and a basket of chip bags."
          >
            <img
              src={asset('images/interior-gallery-wall.jpg')}
              width="1600"
              height="1902"
              alt="A teal wall covered with framed pictures, woven pendant lamps, a rust-colored sofa, and a basket of chip bags."
              loading="lazy"
            />
            <span class="enlarge">Enlarge</span>
          </a>
        </figure>
        <figure class="lobby-item mat-gold">
          <a
            href={asset('images/lobby-jukebox.jpg')}
            data-lightbox
            data-group="lobby"
            data-src={asset('images/lobby-jukebox.jpg')}
            data-alt="A vintage jukebox with rainbow trim beside a window in the shop."
          >
            <img
              src={asset('images/lobby-jukebox.jpg')}
              width="1350"
              height="1800"
              alt="A vintage jukebox with rainbow trim beside a window in the shop."
              loading="lazy"
            />
            <span class="enlarge">Enlarge</span>
          </a>
        </figure>
        <figure class="lobby-item mat-rust">
          <a
            href={asset('images/lobby-sofa.jpg')}
            data-lightbox
            data-group="lobby"
            data-src={asset('images/lobby-sofa.jpg')}
            data-alt="Two women holding coffee mugs on the rust-colored sofa beneath the teal gallery wall."
          >
            <img
              src={asset('images/lobby-sofa.jpg')}
              width="1350"
              height="1800"
              alt="Two women holding coffee mugs on the rust-colored sofa beneath the teal gallery wall."
              loading="lazy"
            />
            <span class="enlarge">Enlarge</span>
          </a>
        </figure>
        <figure class="lobby-item mat-brown">
          <a
            href={asset('images/lobby-doors.jpg')}
            data-lightbox
            data-group="lobby"
            data-src={asset('images/lobby-doors.jpg')}
            data-alt="Glass double doors with sunflower decals and the letters WS, and a Suite A sign above them."
          >
            <img
              src={asset('images/lobby-doors.jpg')}
              width="1350"
              height="1800"
              alt="Glass double doors with sunflower decals and the letters WS, and a Suite A sign above them."
              loading="lazy"
            />
            <span class="enlarge">Enlarge</span>
          </a>
        </figure>
        <figure class="lobby-item mat-dust">
          <video
            class="ambient"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={asset('images/lobby-seating-poster.jpg')}
            width="608"
            height="1080"
            aria-label="A silent loop of the seating area, looking across the lobby and toward the entrance."
          >
            <source src={asset('media/lobby-seating.mp4')} type="video/mp4" />
          </video>
        </figure>
        <figure class="lobby-item mat-teal">
          <video
            class="ambient"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={asset('images/lobby-polaroids-poster.jpg')}
            width="608"
            height="1080"
            aria-label="A silent loop through the lobby, including the gallery wall and the cork Polaroid wall."
          >
            <source src={asset('media/lobby-polaroids.mp4')} type="video/mp4" />
          </video>
        </figure>
      </div>
    </div>
  </section>

  <!-- Section 3: Order a cake and Order a box lunch -->
  <section class="home-orders" data-section="3">
    <h2 class="visually-hidden">Order</h2>
    <div class="home-orders-grid">
      <a class="order-offer" href={shop.cakeForm}>
        <span class="btn">Order a cake</span>
        <img
          src={asset('images/cake-order.jpg')}
          width="1200"
          height="1600"
          alt="A white buttercream cake with pale-blue piped swags, ruffles, and blueberries on top."
          decoding="async"
        />
      </a>
      <a class="order-offer" href={shop.lunchForm}>
        <span class="btn">Order a box lunch</span>
        <img
          src={asset('images/box-lunch-order.jpg')}
          width="1200"
          height="1600"
          alt="Packed box lunches, each with a wrapped sandwich, a bag of chips, and a frosted cupcake."
          decoding="async"
        />
      </a>
    </div>
  </section>

  <!-- Section 4: A neighborhood bakery, still on the same cove -->
  <section class="section block-teal home-story" data-section="4">
    <div class="wrap split">
      <div class="prose">
        <h2>A neighborhood bakery, still on the same cove.</h2>
        <p>
          First established in 2012 in Jackson, Tennessee, Woodstock met the community with something of its own.
        </p>
        <figure class="pull pull-story">
          <blockquote>
            <p>
              I made a ton of mistakes. It takes a long time and a lot of persistence to build a business. I'm a very competitive person, so I knew I was going to figure it out. I just didn't know how long it would take to figure it out. In the beginning, we would have days where ten or fifteen people would walk through the doors. Now it's a few hundred every day. You just have to hang in there for the first two or three years.
            </p>
          </blockquote>
          <cite>quote from founder</cite>
        </figure>
        <p>
          Through the years, Woodstock made a name by generosity and genuine care. In late 2024, the shop came under new ownership. With love for the mission the previous owners instilled, Woodstock continues to make its bright and encouraging mark on the Jackson community.
        </p>
        <figure class="pull pull-story">
          <p>The mission is to serve. Whether it be providing an environment for relationships to grow, offering encouragement to those hurting, or simply a warm smile, let it all be to the glory of God.</p>
          <cite>From the current owner</cite>
        </figure>
      </div>
      <div class="story-side">
        <Shot
          src="images/storefront-facade.jpg"
          width="1800"
          height="2399"
          group="home"
          alt="The Woodstock storefront at 80 Innsdale Cove: a white facade, a sunflower sign with the letters WS, and a neon Open sign in the window."
          caption=""
        />
        <div class="dale-words">
          <ul class="dale-bubbles">
            <li>Anybody can sell a cupcake.</li>
            <li>We inspire lives one box at a time.</li>
            <li>It’s a great day to be alive.</li>
          </ul>
          <p class="dale-by">quote from founder</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Meet the owner/operator -->
  <section class="section home-owner" data-section="5" style="padding-top:0">
    <div class="wrap split">
      <Shot
        src="images/elena-parkerson.jpg"
        width="1500"
        height="2026"
        alt="Elena Parkerson standing in front of the teal gallery wall at Woodstock."
        enlarge={false}
      />
      <div class="prose">
        <h2>Meet the owner/operator, Elena Parkerson.</h2>
        <p>
          At just 18 years old, Elena had two options: college or entrepreneurship. Although the risk was high, she took a leap of faith. Through the encouragement and support of her family, Woodstock gained its newest and youngest owner in late 2024. For her first two years of ownership, she carried the courageous attitude she started with, learning, growing, and making mistakes along the way. Now, at 20 years old, she's taking her biggest risk yet: expanding the business! A partnership with a start-up business is underway. From the beginning, Elena has thanked God every day for the faith, love, and hope it takes to take risks, and for all of the endless opportunities ahead.
        </p>
        <img
          class="owner-mark"
          src={asset('images/woodstock-7-logo.png')}
          width="770"
          height="770"
          alt=""
        />
      </div>
    </div>
  </section>

  <!-- Section 6: Honey Be Good is Jackson’s FIRST family cafe -->
  <section class="band section home-honey" data-section="6">
    <div class="wrap partner">
      <Shot
        src="images/mockups/honey-be-good-play-sketch.jpg"
        width="1080"
        height="681"
        group="partner"
        alt="Pencil sketch of a play café: a wooden play structure with slides on the left, and a long row of tables on the right. The drawing reads Honey Be Good Family Cafe and Jackson’s first play café."
      />
      <div>
        <p class="kicker">Opening winter 2027</p>
        <h2>Honey Be Good is Jackson’s FIRST family cafe</h2>
        <p>
          Play, sip, and belong. Honey Be Good is every parent’s dream. Visit the link below to start your membership today!
        </p>
        <p class="cluster">
          <a class="btn btn-sun" href={shop.honey} target="_blank" rel="noopener noreferrer">honeybeegood.cafe</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Section 7: The Woodstock you love is staying -->
  <section class="chapter-tease" data-section="7" aria-labelledby="chapter-title">
    <div class="chapter-tease-copy">
      <h2 id="chapter-title">The Woodstock you love is staying.</h2>
      <p>
        New things are on the horizon! A new coffee bar, more room to spread out, more places to sit, and the play space beside us. The picture you see is a general mock-up of what's to come!
      </p>
      <p>
        <a class="btn btn-sun" href={href('/expansion')}>Expansion page</a>
      </p>
    </div>
    <img
      src={asset('images/staying-3510.jpg')}
      width="1280"
      height="720"
      alt="Pencil sketch mock-up of the new coffee bar."
      loading="lazy"
    />
  </section>
  <script>
    const ambient = Array.from(document.querySelectorAll<HTMLVideoElement>('video.ambient'));
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const poster = (video: HTMLVideoElement) => {
      const source = video.querySelector('source');
      const src = video.dataset.src || source?.src || '';
      if (src) video.dataset.src = src;
      video.pause();
      video.autoplay = false;
      video.removeAttribute('autoplay');
      source?.remove();
      video.removeAttribute('src');
      video.load();
    };

    const play = (video: HTMLVideoElement) => {
      const src = video.dataset.src;
      if (src && !video.querySelector('source')) {
        const source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';
        video.append(source);
        video.autoplay = true;
        video.load();
      }
      video.play().catch(() => {});
    };

    const applyMotion = () => {
      ambient.forEach((video) => (motion.matches ? poster(video) : play(video)));
    };

    applyMotion();
    motion.addEventListener('change', applyMotion);
  </script>
</Base>

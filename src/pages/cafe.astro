---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { cafeExtras, lattes, milks, shop } from '../data/site';

const title = 'Cafe · Woodstock Coffee & Bakeshop';
const description =
  'New lobby, better ingredients, unforgettable coffee. Specialty coffees at Woodstock in Jackson, made with house-made syrups. More detailed info coming soon. Lattes $4, hot peanut butter cup latte $4.50, black coffee $2.';
---

<Base title={title} description={description}>
  <!-- Section 1: The cafe -->
  <header class="page-hero cafe-hero pop-hero" data-section="1">
    <div class="wrap">
      <h1>The cafe</h1>
      <p class="lede">
        New lobby, better ingredients, unforgettable coffee. Specialty coffees made with house-made syrups, local and organic ingredients, more whole-food choices, brunch favorites, and fresh pastries daily. More detailed info coming soon! The menu below is what we offer now.
      </p>
    </div>
    <div class="cafe-hero-art" aria-hidden="true">
      <svg viewBox="0 0 960 120" width="100%" height="120">
        <path d="M0 78c40-28 70-28 110 0s70 28 110 0 70-28 110 0 70 28 110 0 70-28 110 0 70 28 110 0 70-28 110 0 70 28 110 0 40-14 80 0" fill="none" stroke="#236e77" stroke-width="3" stroke-linecap="round" />
        <path d="M0 96c40-18 70-18 110 0s70 18 110 0 70-18 110 0 70 18 110 0 70-18 110 0 70 18 110 0 70-18 110 0 70 18 110 0 40-8 80 0" fill="none" stroke="#6b7030" stroke-width="2" />
        <g fill="#f1be64">
          <ellipse cx="120" cy="46" rx="7" ry="14" />
          <ellipse cx="120" cy="46" rx="14" ry="7" />
          <ellipse cx="120" cy="46" rx="7" ry="14" transform="rotate(45 120 46)" />
          <ellipse cx="120" cy="46" rx="7" ry="14" transform="rotate(-45 120 46)" />
        </g>
        <circle cx="120" cy="46" r="8" fill="#643b25" />
        <g fill="#bc4d28">
          <ellipse cx="480" cy="38" rx="6" ry="12" />
          <ellipse cx="480" cy="38" rx="12" ry="6" />
          <ellipse cx="480" cy="38" rx="6" ry="12" transform="rotate(45 480 38)" />
          <ellipse cx="480" cy="38" rx="6" ry="12" transform="rotate(-45 480 38)" />
        </g>
        <circle cx="480" cy="38" r="7" fill="#f1be64" />
        <g fill="#f1be64">
          <ellipse cx="820" cy="50" rx="7" ry="14" />
          <ellipse cx="820" cy="50" rx="14" ry="7" />
          <ellipse cx="820" cy="50" rx="7" ry="14" transform="rotate(45 820 50)" />
          <ellipse cx="820" cy="50" rx="7" ry="14" transform="rotate(-45 820 50)" />
        </g>
        <circle cx="820" cy="50" r="8" fill="#236e77" />
      </svg>
    </div>
  </header>

  <!-- Section 2: We're roasting our own coffee -->
  <section class="section block-orange cafe-roast" data-section="2">
    <div class="wrap split">
      <div class="prose">
        <h2>We're roasting our own coffee.</h2>
        <p class="kicker">Coming in February</p>
        <p>
          This February, our very own Bellwether coffee roaster is coming to Woodstock, and we could not be more excited. Soon the beans in your latte will be roasted right here in the shop, in small batches, so every cup starts fresh.
        </p>
        <p>
          It's electric and smokeless, so the roasting happens right where we pour. Come see it once it's here.
        </p>
        <figure class="pull">
          <p>Coffee subscriptions will be available! Take our fresh roasts home on a regular schedule. Details coming soon.</p>
        </figure>
        <p><a class="btn" href={shop.instagram}>Follow along on Instagram</a></p>
      </div>
      <Shot
        src="images/bellwether-roaster.jpg"
        width="1600"
        height="1276"
        group="cafe"
        alt="The Bellwether Shop Roaster, an electric countertop coffee roaster in a deep bronze finish."
        caption="The Bellwether Shop Roaster, coming to Woodstock in February. Photo: Bellwether Coffee."
      />
    </div>
  </section>

  <!-- Section 3: Lattes, extras, and milk -->
  <section class="section" data-section="3" style="padding-top:0">
    <div class="wrap split">
      <div>
        <h2>Lattes</h2>
        <ul class="menu">
          {lattes.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
        <h2 style="margin-top:2.2rem">Extras</h2>
        <ul class="menu">
          {cafeExtras.map((item) => (
            <li>
              <span>{item.name}</span>
              <span class="price">{item.price}</span>
            </li>
          ))}
        </ul>
        <h2 style="margin-top:2.2rem">Milk</h2>
        <ul class="breads">
          {milks.map((milk) => <li>{milk}</li>)}
        </ul>
        <p class="hours-aside">
          Questions about a drink, call <a href={`tel:${shop.phoneTel}`}>{shop.phoneDisplay}</a>.
        </p>
      </div>
      <div class="stack">
        <Shot
          src="images/latte-caramel.jpg"
          width="1080"
          height="1161"
          alt="An iced coffee in a clear glass, topped with foam and a caramel drizzle, on a pale table."
          enlarge={false}
        />
        <Shot
          src="images/latte-iced.jpg"
          width="1600"
          height="2133"
          alt="An iced latte in a plastic cup, held in the shop with the teal wall and pendant lights behind it."
          enlarge={false}
        />
      </div>
    </div>
  </section>

  <!-- Section 4: We can't share too much -->
  <section class="section cafe-share" data-section="4">
    <div class="wrap split">
      <Shot
        src="images/lobby-3397.jpg"
        width="1534"
        height="1600"
        alt="Two women with coffee mugs on the lobby couch, in front of a teal wall of framed art."
        enlarge={false}
      />
      <div class="prose cafe-share-copy">
        <p class="cafe-share-lead">We can’t share too much about the expanded menu just yet…BUT here’s what we can share…</p>
        <ul class="cafe-share-list">
          <li>Plastic free, fully compostable to-go cups</li>
          <li>Custom roasted espresso beans</li>
          <li>Locally farmed ingredients</li>
          <li>House made syrups</li>
        </ul>
        <div class="cafe-share-art" aria-hidden="true">
          <svg viewBox="0 0 360 110" width="100%" height="110">
            <path d="M8 78c22-34 52-34 74 0" fill="none" stroke="#bc4d28" stroke-width="7" stroke-linecap="round" />
            <path d="M20 78c16-24 40-24 50 0" fill="none" stroke="#f1be64" stroke-width="7" stroke-linecap="round" />
            <path d="M32 78c10-14 28-14 26 0" fill="none" stroke="#236e77" stroke-width="7" stroke-linecap="round" />
            <path d="M110 70c36 10 64-16 100-4 30 10 58 6 90-14" fill="none" stroke="#eee0db" stroke-width="3" stroke-linecap="round" />
            <path d="M168 52c8-12 18-6 12 4-6 1-10 2-12-4z" fill="#a9c1c3" />
            <path d="M214 46c9-11 18-5 12 5-6 1-10 2-12-5z" fill="#f1be64" />
            <g transform="translate(300 58)">
              <g fill="#f1be64">
                <ellipse cx="0" cy="-18" rx="6" ry="12" />
                <ellipse cx="0" cy="18" rx="6" ry="12" />
                <ellipse cx="-18" cy="0" rx="12" ry="6" />
                <ellipse cx="18" cy="0" rx="12" ry="6" />
                <ellipse cx="-13" cy="-13" rx="6" ry="12" transform="rotate(-45 -13 -13)" />
                <ellipse cx="13" cy="-13" rx="6" ry="12" transform="rotate(45 13 -13)" />
                <ellipse cx="-13" cy="13" rx="6" ry="12" transform="rotate(45 -13 13)" />
                <ellipse cx="13" cy="13" rx="6" ry="12" transform="rotate(-45 13 13)" />
              </g>
              <circle r="10" fill="#643b25" />
              <circle r="5" fill="#bc4d28" />
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { shop } from '../data/site';
import { asset } from '../lib/url';

const title = 'Catering · Woodstock Coffee & Bakeshop';
const description =
  'Catering from Woodstock in Jackson. Bulk box lunches, cupcakes, and more. We offer delivery. Call 731-554-1969.';

const mats = ['teal', 'gold', 'rust', 'brown', 'dust'] as const;

const collage = [
  { file: 'catering-9014.jpg', width: 1200, height: 1600, alt: 'Rows of cupcakes with pink, chocolate, and white frosting and sprinkles on a metal tray.' },
  { file: 'catering-7951.jpg', width: 1200, height: 1600, alt: 'Rows of open box lunches, each with a wrapped sandwich, a bag of chips, and a cupcake.' },
  { file: 'catering-6159.jpg', width: 1200, height: 1600, alt: 'A box of cupcakes piped as blue hydrangeas and pale roses with green leaves.' },
  { file: 'catering-3108.jpg', width: 1200, height: 1600, alt: 'A box of cupcakes piped as colorful flowers in pink, yellow, orange, and purple.' },
  { file: 'catering-2083.jpg', width: 1200, height: 1600, alt: 'A box of cupcakes piped as pink roses and red and mauve flowers with green centers.' },
  { file: 'catering-1914.jpg', width: 1200, height: 1600, alt: 'A tray of vanilla and chocolate cupcakes with white and cocoa frosting and sprinkles.' },
  { file: 'catering-1912.jpg', width: 1200, height: 1600, alt: 'A tray of pink-frosted cupcakes, each topped with a slice of strawberry.' },
  { file: 'catering-5103.jpg', width: 1200, height: 1600, alt: 'Rows of plastic-wrapped sandwiches on a steel kitchen table.' },
  { file: 'catering-5228.jpg', width: 1200, height: 1600, alt: 'Trays of muffins in chocolate, red, and vanilla with dark pieces baked in.' },
  { file: 'catering-1656.jpg', width: 1200, height: 1600, alt: 'A long table of chip bags and canned drinks.' },
  { file: 'catering-1652.jpg', width: 816, height: 1600, alt: 'Three bins of wrapped sandwiches: club-style, cheese, and croissant sandwiches.' },
  { file: 'catering-2218.jpg', width: 1200, height: 1600, alt: 'An open box of cupcakes piped as yellow and orange roses, with white star dollops, pearls, and gold stars.' },
];

const eventsCopy =
  'Since 2024, Woodstock has participated in local events all over Jackson TN. As well as our very own hosted events here at our home location! If you’re interested in participating in Woodstock related events, follow along on social media to stay up to date!';

const events = [
  { kind: 'image' as const, file: 'events-8397.jpg', width: 1280, height: 960, alt: 'Three people standing and smiling behind a decorated bakery booth table in a sunlit lobby with large windows. The table holds cookies, brownies, cups of dessert, a sunflower, greenery, and pink iridescent tinsel.' },
  { kind: 'image' as const, file: 'events-6996.jpg', width: 1600, height: 1541, alt: 'A Woodstock booth in a large windowed lobby, with a floral arch and a WOODSTOCK C banner, a bottle-cap LOVE sign, black-draped tables of packaged cookies, cupcakes, and drinks, and a sunflower.' },
  { kind: 'image' as const, file: 'events-6959.jpg', width: 1600, height: 1200, alt: 'A closer view of a bakery booth: a bottle-cap LOVE sign, a clear stand of cupcakes, packaged cookies, a rust-colored velvet runner, canned drinks, and a sunflower in a ceramic owl vase.' },
  { kind: 'video' as const, file: 'events-3437.mp4', poster: 'events-3437-poster.jpg', width: 720, height: 1280, label: 'A short handheld pan across a sunlit dessert table under a tent, with trays of cookies, pastries, chocolate-drizzled treats, and spoon desserts with a red topping.' },
  { kind: 'image' as const, file: 'events-1897.jpg', width: 1600, height: 1200, alt: 'An indoor event dessert table against a brick wall, with a pink velvet runner, strawberry shortcakes in cups, cake pops, cupcakes, packaged cookies, macarons, bakery boxes, and sunflowers.' },
  { kind: 'video' as const, file: 'events-173a25d5.mp4', poster: 'events-173a25d5-poster.jpg', width: 720, height: 1280, label: 'A kitchen clip of gloved hands frosting and decorating trays of cupcakes — white, chocolate, and pink swirls, pecans, chocolate chips, and sprinkles — with lunch boxes and handwritten lid notes in the background.' },
  { kind: 'video' as const, file: 'events-9080.mp4', poster: 'events-9080-poster.jpg', width: 720, height: 1280, label: 'A short handheld pan inside the shop during a busy evening gathering. The pastry case is in the foreground; people fill the room, with dusk visible through the front windows and the teal gallery wall at right.' },
  { kind: 'image' as const, file: 'events-9074.jpg', width: 1200, height: 1600, alt: 'A grazing table in the shop, with the jukebox behind it, trays of cheese, salami, peppers, grapes, snap peas, a bowl of dip, chips, pastry swirls on red-and-white check paper, and a bottle-cap LOVE sign.' },
  { kind: 'image' as const, file: 'events-9071.jpg', width: 1200, height: 1600, alt: 'A dessert table by the shop windows: a dark vintage-style decorated cake, two trays of pecan tarts on red-and-white check paper, a gold plate of chocolate cupcakes, and cups of cream dessert with a caramel or fruit topping.' },
  { kind: 'image' as const, file: 'events-9388.jpg', width: 1200, height: 1600, alt: 'A long dessert buffet under a cream tent, with trays of pink-frosted cupcakes, pecan tarts, pastry swirls, sandwich cookies, brownies, and white meringues, and a sunflower at the near corner.' },
];

const reviews = [
  {
    name: 'Israel Núñez',
    text: 'I really enjoyed my visit to Woodstock Café! The place is very clean, and the customer service is excellent. The 16-ounce coffee is offered at a very reasonable price, making it a great value. What makes this café special is its Woodstock-inspired décor, which creates a beautiful, unique, and welcoming atmosphere. The music adds a wonderful touch to the overall experience. Even the restrooms are exceptionally clean and well-maintained. A charming place to enjoy a good cup of coffee!',
  },
  {
    name: 'April Rowe',
    text: 'Custom made cake was delicious and they got it done quickly as I had forgot to order earlier in the week. Had it done within 24 hours. Thank you',
  },
  {
    name: 'Michael Richardson',
    text: "As always, even under new management this place has some of the best baked goods of any place ever. The service is excellent, the dining area is better than ever, and the whole place is just a complete vibe. All created by some of the loveliest ladies you'll ever get the pleasure to converse with.",
  },
  {
    name: 'Justin M.',
    text: "I ordered a pecan and peanut butter pie a couple of weeks ago for Thanksgiving. They were both so yummy! The pecan pie was the best I've ever had.",
  },
  {
    name: 'Nichole Park',
    text: "The cupcakes are so great and the owners are so nice! We love WoodStock Bakery and try to stop by every time we’re in town!",
  },
];
---

<Base title={title} description={description}>
  <!-- Section 1: Catering -->
  <header class="page-hero pop-hero center-hero" data-section="1">
    <div class="wrap">
      <h1>Catering</h1>
      <p class="lede">Get in contact with someone to place your bulk order today.</p>
      <p class="lede">
        We offer delivery. Call <a href={`tel:${shop.phoneTel}`}>{shop.phoneDisplay}</a> or write
        <a href={`mailto:${shop.email}`}>{shop.email}</a>. Tell us the date, about how many people, and where it needs to go.
      </p>
      <p class="hero-actions">
        <a class="btn" href={`tel:${shop.phoneTel}`}>Call the shop</a>
        <a class="btn btn-ghost" href={`mailto:${shop.email}`}>Email us</a>
      </p>
    </div>
  </header>

  <!-- Section 2: Box lunches in bulk, and cupcakes by the dozen -->
  <section class="section block-teal catering-spread" data-section="2">
    <div class="wrap">
      <h2>Box lunches in bulk, and cupcakes by the dozen.</h2>
      <div class="catering-collage">
        {collage.map((photo, index) => (
          <figure class={`catering-mat mat-${mats[index % mats.length]}`}>
            <img
              src={asset(`images/${photo.file}`)}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Ordering, deposits, and reimbursements -->
  <section class="section catering-policy" data-section="3">
    <div class="wrap prose">
      <h2>Ordering</h2>
      <ul>
        <li>We require all custom and bulk orders to be placed within 3 to 4 days in advance.</li>
      </ul>
      <h2>Deposits</h2>
      <ul>
        <li>For integrity purposes, we require a deposit of 50% for bulk order exceeding $100.</li>
        <li>For ALL custom cakes, we require a deposit of the base price depending on the size of the cake.</li>
      </ul>
      <h2>Reimbursements</h2>
      <ul>
        <li>It is our main priority to ensure satisfaction with every customer. Although rare, mistakes can happen. When they happen, private feedback is always taken professionally and responsibly by our staff. We ask as a small business, that if you are unhappy with your order, that you not make a public bad review. As this hurts our growing business. We always appreciate the opportunity to grow and strengthen our customer service.</li>
      </ul>
    </div>
  </section>

  <!-- Section 4: From our customers -->
  <section class="section catering-reviews" data-section="4">
    <div class="wrap">
      <h2>From our customers</h2>
      <div class="review-list">
        {reviews.map((review) => (
          <blockquote>
            <p class="review-stars" aria-label="5 stars">★★★★★</p>
            <p>{review.text}</p>
            <cite>{review.name}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 5: Events -->
  <section class="section block-brown catering-events" data-section="5">
    <div class="wrap">
      <h2>Events</h2>
      <p class="lede">{eventsCopy}</p>
      <p class="hero-actions">
        <a class="btn" href={shop.instagram} target="_blank" rel="noopener">{shop.instagramHandle}</a>
      </p>
      <div class="catering-collage events-collage">
        {events.map((item, index) => (
          <figure class={`catering-mat mat-${mats[index % mats.length]}`}>
            {item.kind === 'image' ? (
              <img
                src={asset(`images/${item.file}`)}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <video
                class="events-clip"
                poster={asset(`images/${item.poster}`)}
                width={item.width}
                height={item.height}
                muted
                playsinline
                loop
                preload="none"
                controls
                aria-label={item.label}
              >
                <source src={asset(`images/${item.file}`)} type="video/mp4" />
              </video>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>
  <script>
    const clips = Array.from(document.querySelectorAll<HTMLVideoElement>('video.events-clip'));
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const sync = (video: HTMLVideoElement, inView: boolean) => {
      if (motion.matches || !inView) {
        video.pause();
        return;
      }
      video.play().catch(() => {});
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => sync(entry.target as HTMLVideoElement, entry.isIntersecting));
    }, { threshold: 0.45 });

    clips.forEach((video) => observer.observe(video));
    motion.addEventListener('change', () => {
      clips.forEach((video) => {
        const rect = video.getBoundingClientRect();
        sync(video, rect.bottom > 0 && rect.top < window.innerHeight);
      });
    });
  </script>
</Base>

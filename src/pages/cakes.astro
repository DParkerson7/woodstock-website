---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { cakeAlbum, cakeSizes, featuredCakes, shop } from '../data/site';

const title = 'Cakes · Woodstock Coffee & Bakeshop';
const description =
  'Custom cakes from Woodstock in Jackson, Tennessee. 6-inch rounds from $45, 8-inch from $55, heart shapes from $60, plus four priced vintage designs. Order on the shop form.';
---

<Base title={title} description={description}>
  <!-- Section 1: Cakes -->
  <header class="page-hero pop-hero" data-section="1">
    <div class="wrap">
      <h1>Cakes</h1>
      <p class="lede">
        Woodstock is known for our affordable, delicious, custom cakes. With a growing team of decorators, expanding flavor options, and genuine love, our mission is to make the process of ordering with us… a piece of cake!
      </p>
      <p class="hero-actions">
        <a class="btn" href={shop.cakeForm}>Order a cake</a>
        <a class="btn btn-ghost" href={`tel:${shop.phoneTel}`}>Or call {shop.phoneDisplay}</a>
      </p>
    </div>
  </header>

  <!-- Section 2: Base prices -->
  <section class="section block-marigold" data-section="2">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Sizes</p>
        <h2>Base prices, exactly as they stand.</h2>
        <p>A base price is a starting point. It is not a promise of a particular flavor, filling, or decoration. Ask, and we will say what the cake you want will cost.</p>
      </div>
      <div class="price-grid three">
        {cakeSizes.map((size) => (
          <article class="price-card">
            <h3>{size.name}</h3>
            <p class="note">{size.note}</p>
            <p class="amount">{size.price}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Four priced designs -->
  <section class="section block-dust" data-section="3" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Priced designs</p>
        <h2>Four cakes with their own prices.</h2>
        <p>
          These are the named designs on the current menu. The photographs further down are recent cakes from the kitchen. A picture is not a flavor, and lettering on a cake belonged to that order.
        </p>
      </div>
      <div class="featured">
        {featuredCakes.map((cake) => (
          <article>
            <h3>{cake.name}</h3>
            <p class="amount">{cake.price}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: How the decorating team works -->
  <section class="section" data-section="4" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">How the decorating team works</p>
        <h2>Affordable, plain about the price, and reliable about the day.</h2>
        <p>
          That is the aim: a cake you can afford, a number you understand before you commit, and a pickup you can count on. If a date or a design is not possible, we would rather say so. There are no staff biographies on this page yet. When the people who decorate want a few words here, they will be their own.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 5: Flavors, fillings, and buttercream -->
  <section class="section" data-section="5" style="padding-top:0" aria-labelledby="flavors-title">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Still to be written down</p>
        <h2 id="flavors-title">Flavors, fillings, and buttercream.</h2>
        <p>
          The full flavor list is coming soon. We are not going to guess at it. When you order, we will tell you what is on the bench.
        </p>
      </div>
      <div class="flavor-board">
        <article>
          <h3>Cake flavors</h3>
          <p class="soon">Coming soon</p>
        </article>
        <article>
          <h3>Fillings</h3>
          <p class="soon">Coming soon</p>
        </article>
        <article>
          <h3>Buttercream</h3>
          <p class="soon">Coming soon</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 6: Recent cakes -->
  <section class="section" data-section="6" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <p class="kicker">Album</p>
        <h2>Recent cakes from the kitchen.</h2>
        <p>Enlarge any photograph. Inscriptions — a 20th, a wedding — were for those orders.</p>
      </div>
      <div class="album">
        {cakeAlbum.map((photo) => (
          <Shot {...photo} group="cakes" />
        ))}
      </div>
    </div>
  </section>

  <!-- Section 7: Kitchen notes and reviews -->
  <section class="section" data-section="7" style="padding-top:0">
    <div class="wrap split">
      <div class="kitchen-slot">
        <p class="kicker">From the kitchen</p>
        <h2>Buttercream, the bench, and the moment a box opens.</h2>
        <p>
          Short films of decorating and of cakes being opened will live here. Until they do, the day-to-day is on Instagram. This is a link, not a video we invented.
        </p>
        <p><a class="btn" href={shop.instagram}>See the shop on Instagram</a></p>
      </div>
      <div>
        <p class="kicker">From the table</p>
        <h2>Reviews, when they are real.</h2>
        <p class="empty-review">
          Kind words from people who ordered with us will go here. We would rather leave the space open than put words in anyone’s mouth.
        </p>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { shop } from '../data/site';
import { asset } from '../lib/url';

const title = 'Cakes · Woodstock Coffee & Bakeshop';
const description =
  'Custom cakes from Woodstock in Jackson, Tennessee. 6-inch rounds from $45, 8-inch from $55, heart shapes from $60. Order on the shop form.';

const videos = [
  {
    src: 'videos/cake-video-1.mp4',
    poster: 'images/cakes/cake-video-1.jpg',
    label: 'A white heart-shaped cake with piped shells and pearls on a steel work table, as a decorator pipes the inscription.',
  },
  {
    src: 'videos/cake-video-2.mp4',
    poster: 'images/cakes/cake-video-2.jpg',
    label: 'A chocolate heart cake with black ribbon bows and white script, turning on a cake stand.',
  },
  {
    src: 'videos/cake-video-3.mp4',
    poster: 'images/cakes/cake-video-3.jpg',
    label: 'A white round cake with piped swags and sugar flowers, rotating on a silver stand.',
  },
];

const strip = [
  { code: '9122', width: 1200, height: 1600, alt: 'A blue-and-white round cake topped with blueberries and “Baby boy” piped on top.' },
  { code: '9429', width: 1200, height: 1600, alt: 'A red heart cake with black ribbon bows and “happy 20th” piped in white.' },
  { code: '8757', width: 1068, height: 1600, alt: 'A blue cake with pink and green piping, carrot motifs, and chocolate-covered strawberries styled as carrots.' },
  { code: '5298', width: 1200, height: 1600, alt: 'A green-and-lavender cake in a box, topped with red mushroom decorations and “Sixteen” piped on top.' },
  { code: '2317', width: 1200, height: 1600, alt: 'Two yellow bee-themed cakes on a wooden bakery counter, one with a small bee and flowers, the other with a pink lattice.' },
  { code: '0610', width: 1200, height: 1600, alt: 'A light-blue round cake with ruffled piping, pearls, and swags, sitting in an open white box.' },
];

const sizes = [
  {
    name: '6 inch round — $45',
    src: 'images/cakes/cake-size-6in-1561.jpg',
    width: 1200,
    height: 1600,
    alt: 'A small white round cake with pearl sprinkles and a shell border, in an open bakery box.',
  },
  {
    name: '8 inch round — $55',
    src: 'images/cakes/cake-size-8in-5675.jpg',
    width: 900,
    height: 1600,
    alt: 'A white round cake with piped swags, pearls, and white flowers, on a silver stand.',
  },
  {
    name: '8 inch heart shape — $60',
    src: 'images/cakes/cake-size-8heart-8798.jpg',
    width: 1200,
    height: 1600,
    alt: 'A white heart-shaped cake with piped shells, swags, and pearls, in an open bakery box.',
  },
];

const wedding = [
  { code: '8500', width: 943, height: 1600, alt: 'A two-tier white wedding cake with a gold-edged top, yellow roses, greenery, and a gold base, with a cake knife and server beside it.' },
  { code: '6201', width: 1200, height: 1600, alt: 'A three-tier white cake with piped swags and small pink flowers, photographed in the bakery.' },
  { code: '1269', width: 1200, height: 1600, alt: 'A white heart cake with pearls and “Just Married” written in gold on top.' },
  { code: '2266', width: 1200, height: 1600, alt: 'A two-tier rustic wedding cake with white frosting, sugar flowers, greenery, and purple asters, in front of a stone fireplace.' },
  { code: '8815', width: 1200, height: 1600, alt: 'A white heart-shaped cake with piped swags, shells, and pearls, on a board on a work table.' },
];
---

<Base title={title} description={description}>
  <!-- Section 1: Cakes -->
  <header class="page-hero pop-hero" data-section="1">
    <div class="wrap">
      <h1>Cakes</h1>
      <p class="lede">
        Woodstock is known for our affordable, delicious, custom cakes. With a growing team of decorators, expanding flavor options, and genuine love, our mission is to make the process of ordering with us… a piece of cake!
      </p>
      <p class="hero-actions">
        <a class="btn" href={shop.cakeForm}>Order a cake</a>
        <a class="btn btn-ghost" href={`tel:${shop.phoneTel}`}>Or call {shop.phoneDisplay}</a>
      </p>
    </div>
  </header>

  <!-- Section 2: Cake display -->
  <section class="section cakes-show" data-section="2">
    <h2 class="visually-hidden">Cakes from the kitchen</h2>
    <div class="wrap cake-videos">
      {videos.map((video) => (
        <video
          class="ambient"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={asset(video.poster)}
          width="608"
          height="1080"
          aria-label={video.label}
        >
          <source src={asset(video.src)} type="video/mp4" />
        </video>
      ))}
    </div>
    <div class="make-marquee cakes-marquee" tabindex="0" aria-label="Cakes from the shop">
      <div class="make-marquee-track">
        {[0, 1].map((copy) => (
          <ul class="make-marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {strip.map((photo) => (
              <li>
                <img
                  src={asset(`images/cakes/cakes-strip-${photo.code}.jpg`)}
                  width="600"
                  height={Math.round(600 * photo.height / photo.width)}
                  alt={copy === 1 ? '' : photo.alt}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Prices, sizes, and more -->
  <section class="section cakes-prices" data-section="3">
    <div class="wrap">
      <h2>Prices, sizes, and more</h2>
      <div class="cake-sizes">
        {sizes.map((size) => (
          <article>
            <h3>{size.name}</h3>
            <img
              src={asset(size.src)}
              width={size.width}
              height={size.height}
              alt={size.alt}
              loading="lazy"
              decoding="async"
            />
          </article>
        ))}
      </div>
      <p class="cake-price-note">
        The base price is just a starting point to your order. The cake flavor, fillings, and design can be customized following your choice of size. After placing an inquiry, a cake decorator will give you a quote.
      </p>
      <p>
        <a class="btn" href={shop.cakeForm}>Order a cake</a>
      </p>
    </div>
  </section>

  <!-- Section 4: Wedding cakes -->
  <section class="section cakes-wedding" data-section="4">
    <div class="wrap">
      <h2>Wedding cakes</h2>
      <p>
        Our team is dedicated to being the best option for your wedding! We offer affordable prices, delivery, and customer service that stands out in the wedding industry.
      </p>
      <div class="wedding-grid">
        {wedding.map((photo) => (
          <img
            src={asset(`images/cakes/wedding-${photo.code}.jpg`)}
            width={photo.width}
            height={photo.height}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>
  </section>
  <script>
    const ambient = Array.from(document.querySelectorAll<HTMLVideoElement>('video.ambient'));
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const poster = (video: HTMLVideoElement) => {
      const source = video.querySelector('source');
      const src = video.dataset.src || source?.src || '';
      if (src) video.dataset.src = src;
      video.pause();
      video.autoplay = false;
      video.removeAttribute('autoplay');
      source?.remove();
      video.removeAttribute('src');
      video.load();
    };
    const play = (video: HTMLVideoElement) => {
      const src = video.dataset.src;
      if (src && !video.querySelector('source')) {
        const source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';
        video.append(source);
        video.autoplay = true;
        video.load();
      }
      video.play().catch(() => {});
    };
    const applyMotion = () => {
      ambient.forEach((video) => (motion.matches ? poster(video) : play(video)));
    };
    applyMotion();
    motion.addEventListener('change', applyMotion);

    const scroller = document.querySelector<HTMLElement>('.cakes-marquee');
    if (scroller && !scroller.dataset.ready) {
      scroller.dataset.ready = 'true';
      const reduce = motion.matches;
      const fineHover = window.matchMedia('(hover: hover)').matches;
      let hover = false;
      let pointers = 0;
      let holdUntil = 0;
      let moved = false;
      let startLeft = 0;
      let dragX = 0;
      let dragLeft = 0;
      let last = 0;
      const speed = 40;
      const halfWidth = () => scroller.scrollWidth / 2;
      const looping = () => {
        const copy = scroller.querySelector('.make-marquee-group[aria-hidden="true"]');
        return !reduce && !!copy && getComputedStyle(copy).display !== 'none';
      };
      const wrap = () => {
        if (!looping()) return;
        const half = halfWidth();
        if (half > 8 && scroller.scrollLeft >= half) scroller.scrollLeft -= half;
      };
      const holding = () => hover || pointers > 0 || performance.now() < holdUntil;
      const frame = (now: number) => {
        if (!last) last = now;
        const dt = Math.min(48, now - last);
        last = now;
        if (!reduce && !holding()) {
          scroller.classList.remove('is-user');
          scroller.scrollLeft += (speed * dt) / 1000;
          wrap();
        }
        requestAnimationFrame(frame);
      };
      scroller.addEventListener('mouseenter', () => {
        if (fineHover) hover = true;
      });
      scroller.addEventListener('mouseleave', () => {
        hover = false;
      });
      scroller.addEventListener('pointerdown', (event) => {
        pointers += 1;
        moved = false;
        startLeft = scroller.scrollLeft;
        dragX = event.clientX;
        dragLeft = scroller.scrollLeft;
        scroller.classList.add('is-user');
      });
      scroller.addEventListener('pointermove', (event) => {
        if (pointers === 0) return;
        if (Math.abs(scroller.scrollLeft - startLeft) > 6) moved = true;
        if (event.pointerType === 'touch') return;
        const dx = event.clientX - dragX;
        if (Math.abs(dx) > 6) moved = true;
        scroller.scrollLeft = dragLeft - dx;
        wrap();
      });
      const release = () => {
        pointers = Math.max(0, pointers - 1);
        holdUntil = performance.now() + 3500;
      };
      scroller.addEventListener('pointerup', release);
      scroller.addEventListener('pointercancel', release);
      scroller.addEventListener('wheel', () => {
        scroller.classList.add('is-user');
        holdUntil = performance.now() + 3500;
        requestAnimationFrame(wrap);
      }, { passive: true });
      scroller.addEventListener('scroll', () => wrap(), { passive: true });
      if (!reduce) requestAnimationFrame(frame);
    }
  </script>
</Base>

---
import { nav } from '../data/site';
import { asset, href, isCurrent } from '../lib/url';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={href('/')}>
      <img src={asset('images/logo-sunflower.png')} width="1080" height="1080" alt="" />
      <span class="brand-name">
        <strong>Woodstock</strong>
        <span>Coffee &amp; Bakeshop</span>
      </span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i><i></i></span>
      Menu
    </button>
    <nav id="site-nav" class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={href(item.href)} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (button && nav && !button.dataset.ready) {
    button.dataset.ready = 'true';
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.classList.toggle('nav-open', open);
    };
    button.addEventListener('click', () => {
      setOpen(!nav.classList.contains('is-open'));
    });
    nav.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof HTMLAnchorElement) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>

---
import { asset } from '../lib/url';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
  group?: string;
  eager?: boolean;
}

const { src, alt, caption, width, height, group = 'gallery', eager = false } = Astro.props;
const full = asset(src);
const capId = `cap-${src.replace(/[^a-z0-9]+/gi, '-')}`;
---

<figure class="shot">
  <a
    class="shot-open"
    href={full}
    data-lightbox
    data-group={group}
    data-src={full}
    data-alt={alt}
    data-caption={caption ?? alt}
    aria-haspopup="dialog"
    aria-describedby={caption ? capId : undefined}
  >
    <img
      src={full}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <span class="enlarge">Enlarge</span>
  </a>
  {caption && <figcaption id={capId}>{caption}</figcaption>}
</figure>
